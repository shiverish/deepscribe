<Window x:Class="SeeScribe.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="SeeScribe — Instellingen"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E24">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#121217"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SeeScribe" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Vastleggingen gaan naar DeepScribe, waar een agent ze oppakt."
                       Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Sneltoets voor vastleggen" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding SnapshotHotkey, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Field}"/>

            <TextBlock Text="Maximale opnameduur in seconden" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding MaxVideoSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Field}"/>

            <CheckBox IsChecked="{Binding PlayNotificationSound}"
                      Content="Melding tonen na opslaan"
                      Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,20"/>

            <Border Background="#121217" BorderBrush="#374151" BorderThickness="1"
                    CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Verbinding" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding DeepScribeStatus}" Foreground="#E2E8F0"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Opnieuw controleren" Style="{StaticResource Action}"
                    Command="{Binding RefreshDeepScribeStatusCommand}"/>
            <Button Content="Annuleren" Style="{StaticResource Action}" Command="{Binding CancelCommand}"/>
            <Button Content="Opslaan" Style="{StaticResource Action}" Background="#2563EB"
                    Foreground="#FFFFFF" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
