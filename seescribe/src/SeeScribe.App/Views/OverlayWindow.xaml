<Window x:Class="SeeScribe.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SeeScribe.App.Views.Controls"
        mc:Ignorable="d"
        Title="SeeScribe Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" Cursor="Cross">
        <!-- Background Frozen Screenshot -->
        <Image x:Name="BackgroundImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- Inking Layer for Freehand Pen and Highlighter -->
        <InkCanvas x:Name="MainInkCanvas" 
                   Background="Transparent" 
                   EditingMode="None"/>

        <!-- Vector Drawing Canvas for Arrows, Rectangles, Ellipses, Step Badges -->
        <Canvas x:Name="VectorCanvas" 
                Background="Transparent"
                MouseDown="VectorCanvas_MouseDown"
                MouseMove="VectorCanvas_MouseMove"
                MouseUp="VectorCanvas_MouseUp"/>

        <!-- Floating Annotation Toolbar -->
        <controls:AnnotationToolbar x:Name="Toolbar" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,30"
                                   Cursor="Arrow"/>
    </Grid>
</Window>
