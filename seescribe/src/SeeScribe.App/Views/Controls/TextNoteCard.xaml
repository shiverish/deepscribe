<UserControl x:Class="SeeScribe.App.Views.Controls.TextNoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Focusable="True">
    <UserControl.Resources>
        <DropShadowEffect x:Key="NoteShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Background="#E61E1E24"
            BorderBrush="#EF4444"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="8,6"
            MinWidth="110"
            MaxWidth="380"
            Effect="{StaticResource NoteShadow}">
        <Grid>
            <!-- Delete Button in top right (visible on hover) -->
            <Button x:Name="DeleteButton"
                    Width="18" Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    Padding="0"
                    Background="#374151"
                    Foreground="#94A3B8"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Delete note"
                    Visibility="Collapsed"
                    Click="DeleteButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="9"/>
                    </Style>
                </Button.Resources>
                <TextBlock Text="✕" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- Display Mode -->
            <TextBlock x:Name="DisplayTextBlock"
                       Foreground="#F8FAFC"
                       FontSize="13.5"
                       TextWrapping="Wrap"
                       Margin="2,2,14,2"
                       Cursor="SizeAll"
                       Visibility="Collapsed"/>

            <!-- Edit Mode -->
            <Grid x:Name="EditGrid" Visibility="Visible">
                <TextBox x:Name="InputBox"
                         Background="Transparent"
                         Foreground="#F8FAFC"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="13.5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinWidth="100"
                         MinHeight="22"
                         CaretBrush="#F8FAFC"
                         VerticalContentAlignment="Top"
                         TextChanged="InputBox_TextChanged"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         LostFocus="InputBox_LostFocus"/>
                <TextBlock x:Name="PlaceholderBlock"
                           Text="Type a note... (Ctrl+Enter)"
                           Foreground="#64748B"
                           FontSize="13.5"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
