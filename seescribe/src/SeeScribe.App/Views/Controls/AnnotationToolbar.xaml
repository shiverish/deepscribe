<UserControl x:Class="SeeScribe.App.Views.Controls.AnnotationToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:SeeScribe.Core.Enums;assembly=SeeScribe.Core"
             xmlns:conv="clr-namespace:SeeScribe.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="850">
    <Border Background="#1E1E24" 
            BorderBrush="#3B82F6" 
            BorderThickness="1.5" 
            CornerRadius="16" 
            Padding="14,10" 
            Margin="10"
            Effect="{DynamicResource DropShadowEffect}">
        <Border.Resources>
            <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
            <conv:EnumToBooleanConverter x:Key="EnumToBool"/>

            <!-- De twee invoervelden delen deze stijl, zodat titel en beschrijving
                 als één veld ogen dat langer wordt. -->
            <Style x:Key="CaptureInput" TargetType="TextBox">
                <Setter Property="Background" Value="#121217"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#374151"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="CaretBrush" Value="#F8FAFC"/>
            </Style>

            <!-- Grijze hint die verdwijnt zodra er getypt wordt. Twee lege vakken
                 onder elkaar zeggen anders niet welk vak waarvoor is. -->
            <Style x:Key="InputHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Margin" Value="14,0,0,0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>


            <Style x:Key="ToolButton" TargetType="RadioButton">
                <Setter Property="Background" Value="#2A2A35"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#38384A"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Background" Value="#2A2A35"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#38384A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Het knopje dat de beschrijving open- en dichtklapt. Licht ook op wanneer
                 het veld dicht staat maar er wel iets in getypt is. -->
            <Style x:Key="DescriptionToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#374151"/>
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4B5563"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ColorRadio" TargetType="RadioButton">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Ellipse x:Name="outer" Stroke="Transparent" StrokeThickness="2" Margin="-2"/>
                                <Ellipse Fill="{TemplateBinding Background}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="outer" Property="Stroke" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keuzelijst in dezelfde donkere stijl als de rest van de werkbalk.
                 Een ComboBox geeft zijn achtergrond niet door aan de uitklaplijst,
                 dus daar is een eigen sjabloon voor nodig. -->
            <Style x:Key="TargetComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#E2E8F0"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" Margin="4,1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="itemBorder" Property="Background" Value="#2A2A35"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="itemBorder" Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TargetCombo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#F8FAFC"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource TargetComboItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="shell" Background="#121217" BorderBrush="#374151"
                                                    BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" Margin="12,0,4,0" VerticalAlignment="Center"/>
                                                    <Path Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 5 L 10 0" Stroke="#94A3B8" StrokeThickness="1.6"
                                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="shell" Property="BorderBrush" Value="#4B5563"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="shell" Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="selection" IsHitTestVisible="False"
                                                  Margin="12,0,32,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       Placement="Top" VerticalOffset="-6" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="#1E1E24" BorderBrush="#374151" BorderThickness="1"
                                            CornerRadius="10" Padding="0,4" Margin="0,0,0,6"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320"
                                            Effect="{DynamicResource DropShadowEffect}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <StackPanel Orientation="Vertical">
            <!-- Top row: Tools and Colors -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drawing tools -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.Arrow}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.Arrow}"
                                 ToolTip="Arrow (1)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↗ Arrow" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.Pen}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.Pen}"
                                 ToolTip="Pen (2)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ Pen" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="2" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.Rectangle}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.Rectangle}"
                                 ToolTip="Rectangle (3)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▢ Rectangle" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="3" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.Ellipse}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.Ellipse}"
                                 ToolTip="Ellipse (4)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="◯ Ellipse" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="4" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.TextBadge}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.TextBadge}"
                                 ToolTip="Step badge (5)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔢 Step" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="5" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="DrawingTools"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:DrawingTool.Highlighter}, Mode=TwoWay}"
                                 Command="{Binding SelectToolCommand}" CommandParameter="{x:Static enums:DrawingTool.Highlighter}"
                                 ToolTip="Highlighter (6)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖍 Highlight" Margin="0,0,5,0"/>
                            <Border Background="#16161C" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="6" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>


                <!-- Separator -->
                <Rectangle Grid.Column="1" Width="1" Fill="#374151" Margin="8,2"/>

                <!-- Colors & Undo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#EF4444" IsChecked="True"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#EF4444" ToolTip="Rood"/>
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#F59E0B"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#F59E0B" ToolTip="Oranje/Geel"/>
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#10B981"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#10B981" ToolTip="Groen"/>
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#3B82F6"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#3B82F6" ToolTip="Blauw"/>
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#EC4899"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#EC4899" ToolTip="Roze/Magenta"/>
                    <RadioButton Style="{StaticResource ColorRadio}" Background="#FFFFFF"
                                 Command="{Binding SelectColorCommand}" CommandParameter="#FFFFFF" ToolTip="Wit"/>

                    <Button Style="{StaticResource ActionButton}" Content="↩ Undo" Command="{Binding UndoCommand}" Margin="12,0,2,0"/>
                    <Button Style="{StaticResource ActionButton}" Content="🗑 Wis alles" Command="{Binding ClearCommand}"/>
                </StackPanel>

                <!-- Close -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="✕ Sluiten (Esc)" Command="{Binding CloseCommand}" Background="#374151"/>
                </StackPanel>
            </Grid>

            <!-- Bottom row: Prompt Input, Voice, Submit -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Text Prompt Box -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="PromptInputBox" Style="{StaticResource CaptureInput}" Height="38"
                             Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Style="{StaticResource InputHint}" VerticalAlignment="Center"
                               Text="Waar gaat het over?"
                               Visibility="{Binding Text, ElementName=PromptInputBox, Converter={StaticResource EmptyToVisibility}}"/>
                </Grid>

                <!-- Beschrijving erbij; blijft dicht zolang één regel genoeg is -->
                <ToggleButton x:Name="DescriptionToggleButton" Grid.Column="1" Margin="6,0,0,0" Height="38" Padding="12,0"
                              Style="{StaticResource DescriptionToggle}"
                              IsChecked="{Binding IsDescriptionVisible, Mode=TwoWay}"
                              ToolTip="Beschrijving toevoegen (Ctrl+D). Enter maakt daar een nieuwe regel, Ctrl+Enter slaat op.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📝 " FontSize="14"/>
                        <TextBlock Text="Beschrijving"/>
                        <TextBlock Text=" •" Foreground="#60A5FA" FontWeight="Bold"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Waar de vastlegging naartoe gaat; standaard de inbox -->
                <ComboBox x:Name="TargetSelector" Grid.Column="2" Margin="6,0,0,0" Height="38" MinWidth="160" MaxWidth="240"
                          Style="{StaticResource TargetCombo}"
                          ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="Title"
                          ToolTip="Kies een project, of laat het in de inbox staan."/>

                <!-- Voice Recording Button -->
                <Button Grid.Column="3" Margin="6,0,0,0" Height="38" Padding="14,0" Cursor="Hand"
                        Command="{Binding ToggleVoiceRecordingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Background" Value="#374151"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecordingAudio}" Value="True">
                                    <Setter Property="Background" Value="#DC2626"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎙 " FontSize="14"/>
                        <TextBlock Text="{Binding RecordingStatusText}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Opslaan in DeepScribe -->
                <Button x:Name="SubmitButton" Grid.Column="4" Margin="6,0,0,0" Height="38" Padding="18,0"
                        Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" Cursor="Hand"
                        Click="OnSubmitClicked">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Background" Value="#374151"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💾 Opslaan (Enter)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- De beschrijving. Groeit onder de titelregel uit, zodat de volgorde
                 leest zoals het item er in DeepScribe uit komt te zien. -->
            <Grid Margin="0,6,0,0" Visibility="{Binding IsDescriptionVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBox x:Name="DescriptionInputBox" Style="{StaticResource CaptureInput}"
                         Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="150"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         IsVisibleChanged="DescriptionInputBox_IsVisibleChanged"
                         PreviewKeyDown="DescriptionInputBox_PreviewKeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Style="{StaticResource InputHint}" VerticalAlignment="Top" Margin="14,9,0,0"
                           Text="Beschrijving — wat een agent verder moet weten. Ctrl+Enter slaat op."
                           Visibility="{Binding Text, ElementName=DescriptionInputBox, Converter={StaticResource EmptyToVisibility}}"/>
            </Grid>

            <TextBlock Text="{Binding SaveMessage}" Margin="2,8,2,0" FontSize="12.5"
                       TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- Standaard rood: een melding die blijft staan is een mislukking,
                             want bij succes sluit de overlay meteen. -->
                        <Setter Property="Foreground" Value="#FCA5A5"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
