{
  "name": "deepscribe",
  "private": true,
  "version": "0.2.21",
  "description": "Local-first hierarchical writing and knowledge app with Miller columns",
  "license": "GPL-3.0-or-later",
  "author": "shiverish",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "app:start": "cross-env NODE_ENV=production electron .",
    "app:build": "npm run build && npm run seescribe:build && electron-builder --publish never",
    "app:release": "npm run build && npm run seescribe:build && electron-builder --publish always",
    "mcp:start": "node mcp/server.mjs",
    "mcp:test": "node mcp/smoke-test.mjs",
    "mcpb:build": "node mcp/build-mcpb.mjs",
    "skill:build": "node integrations/chatgpt/build-skill.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "seescribe:build": "dotnet build seescribe/src/SeeScribe.App/SeeScribe.App.csproj -c Release",
    "seescribe:test": "dotnet test seescribe/SeeScribe.slnx"
  },
  "build": {
    "appId": "com.deepscribe.app",
    "productName": "DeepScribe",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shiverish",
        "repo": "deepscribe",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepScribe",
      "artifactName": "${productName}-Setup.${ext}",
      "differentialPackage": true
    },
    "extraResources": [
      {
        "from": "seescribe/src/SeeScribe.App/bin/Release/net8.0-windows",
        "to": "seescribe",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/file-saver": "^2.0.7",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "volta": {
    "node": "22.23.2"
  }
}
